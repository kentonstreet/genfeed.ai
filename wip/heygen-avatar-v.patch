@@ -0,0 +1,96 @@
+import type { SchemaFixture } from '@api/seeds/reviewed-provider-rates-seed.types';
+
+/**
+ * Provider schemas for the HeyGen rate-sheet entries. HeyGen publishes no
+ * Replicate-style prediction schema, so the seed carries these hand-written
+ * ones, limited to the fields we send and read from the 2026-10-10 API notes.
+ *
+ * `resolution` is deliberately absent from the avatar input schema: HeyGen
+ * prices by output second whatever the resolution, and a `resolution` property
+ * would make the quote demand a resolution selector the rate sheet does not
+ * carry, leaving the model unpriceable.
+ */
+const SPEECH_OPENAPI: SchemaFixture['openapi'] = {
+  components: {
+    schemas: {
+      Input: {
+        properties: {
+          expressiveness_boost: {
+            description: 'Instant voices only.',
+            maximum: 1,
+            minimum: 0,
+            type: 'number',
+          },
+          language: { type: 'string' },
+          model: { const: 'heygen-voice-1', type: 'string' },
+          text: { maxLength: 5000, minLength: 1, type: 'string' },
+          voice_id: { type: 'string' },
+        },
+        required: ['model', 'voice_id', 'text'],
+        title: 'Input',
+        type: 'object',
+      },
+      Output: {
+        properties: {
+          audio_url: { format: 'uri', type: 'string' },
+          duration: { type: 'number' },
+        },
+        required: ['audio_url'],
+        title: 'Output',
+        type: 'object',
+      },
+    },
+  },
+  openapi: '3.1.0',
+};
+
+function avatarOpenapi(
+  engine: 'avatar_iv' | 'avatar_v',
+): SchemaFixture['openapi'] {
+  return {
+    components: {
+      schemas: {
+        Input: {
+          properties: {
+            avatar_id: { type: 'string' },
+            engine: {
+              properties: { type: { const: engine, type: 'string' } },
+              type: 'object',
+            },
+            script: { maxLength: 5000, type: 'string' },
+            type: { const: 'avatar', type: 'string' },
+            voice_id: { type: 'string' },
+          },
+          required: ['type', 'avatar_id'],
+          title: 'Input',
+          type: 'object',
+        },
+        Output: {
+          properties: {
+            status: { type: 'string' },
+            video_id: { type: 'string' },
+          },
+          required: ['video_id'],
+          title: 'Output',
+          type: 'object',
+        },
+      },
+    },
+    openapi: '3.1.0',
+  };
+}
+
+export const HEYGEN_SCHEMA_FIXTURES: Readonly<Record<string, SchemaFixture>> = {
+  'heygen/avatar-iv': {
+    openapi: avatarOpenapi('avatar_iv'),
+    schemaFamily: 'heygen-avatar-video-v1',
+  },
+  'heygen/avatar-v': {
+    openapi: avatarOpenapi('avatar_v'),
+    schemaFamily: 'heygen-avatar-video-v1',
+  },
+  'heygen/heygen-voice-1': {
+    openapi: SPEECH_OPENAPI,
+    schemaFamily: 'heygen-speech-v1',
+  },
+};
