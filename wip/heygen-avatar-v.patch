+import type { HeyGenAvatarRef } from '@genfeedai/contracts/interfaces';
+
+/** Engines priced in the rate sheet; Avatar III is deliberately not offered. */
+export type HeyGenAvatarEngine = 'avatar_iv' | 'avatar_v';
+
+/** What eligibility needs from a look, both read from `GET /v3/avatars/looks`. */
+export type HeyGenAvatarLookFacts = Pick<
+  HeyGenAvatarRef,
+  'avatarType' | 'supportedEngines'
+>;
+
+/** The `engine` object on `POST /v3/videos` for the avatar variant. */
+export interface HeyGenEngineConfig {
+  type: HeyGenAvatarEngine;
+}
+
+/** An engine chosen for one look, carrying the facts it was checked against. */
+export interface HeyGenAvatarEngineSelection {
+  avatar: HeyGenAvatarLookFacts;
+  engine: HeyGenAvatarEngine;
+}
+
+/** The rate-sheet selector that picks an Avatar IV price band. */
+export interface HeyGenAvatarPricingSelector {
+  avatar_type: 'digital_twin' | 'photo_avatar' | 'studio_avatar';
+}
