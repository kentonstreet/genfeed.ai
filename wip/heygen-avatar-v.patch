@@ -0,0 +1,69 @@
+import type {
+  HeyGenAvatarEngine,
+  HeyGenAvatarLookFacts,
+  HeyGenAvatarPricingSelector,
+  HeyGenEngineConfig,
+} from '@api/services/integrations/heygen/heygen-avatar-engine.types';
+import { MODEL_KEYS } from '@genfeedai/contracts/constants';
+
+/** Rate-sheet and catalog key for each engine. */
+export const HEYGEN_AVATAR_ENGINE_MODEL_KEYS: Readonly<
+  Record<HeyGenAvatarEngine, string>
+> = {
+  avatar_iv: MODEL_KEYS.HEYGEN_AVATAR_IV,
+  avatar_v: MODEL_KEYS.HEYGEN_AVATAR_V,
+};
+
+const PRICED_AVATAR_TYPES: readonly HeyGenAvatarPricingSelector['avatar_type'][] =
+  ['digital_twin', 'photo_avatar', 'studio_avatar'];
+
+/**
+ * The Avatar IV price band for a look, or null when the type is not one the
+ * sheet prices (`image`, `prompt`, or unknown). An unpriced look is refused,
+ * never billed at a guessed band.
+ */
+export function heyGenAvatarPricingSelector(
+  avatarType: string | null,
+): HeyGenAvatarPricingSelector | null {
+  const priced = PRICED_AVATAR_TYPES.find((type) => type === avatarType);
+  return priced ? { avatar_type: priced } : null;
+}
+
+/**
+ * Why an engine cannot render this look, or null when it can.
+ *
+ * Avatar IV needs a priced avatar type and `avatar_iv` in the look's
+ * `supported_api_engines`. Avatar V is opt-in per look: custom video
+ * (`digital_twin`) avatars only, and only when the look lists `avatar_v`.
+ * HeyGen answers an unlisted engine with a 400, so this fails before a
+ * paid submission rather than after.
+ */
+export function heyGenAvatarEngineIneligibility(
+  engine: HeyGenAvatarEngine,
+  avatar: HeyGenAvatarLookFacts,
+): string | null {
+  if (!avatar.supportedEngines.includes(engine))
+    return `This avatar does not support the ${engine === 'avatar_v' ? 'Avatar V' : 'Avatar IV'} engine.`;
+  if (engine === 'avatar_v')
+    return avatar.avatarType === 'digital_twin'
+      ? null
+      : 'Avatar V takes custom video (digital twin) avatars only.';
+  return heyGenAvatarPricingSelector(avatar.avatarType)
+    ? null
+    : 'This avatar type has no verified Avatar IV price.';
+}
+
+/** Model keys the router may pick for this look; empty when it can render none. */
+export function eligibleHeyGenAvatarModelKeys(
+  avatar: HeyGenAvatarLookFacts,
+): string[] {
+  return (Object.keys(HEYGEN_AVATAR_ENGINE_MODEL_KEYS) as HeyGenAvatarEngine[])
+    .filter((engine) => heyGenAvatarEngineIneligibility(engine, avatar) === null)
+    .map((engine) => HEYGEN_AVATAR_ENGINE_MODEL_KEYS[engine]);
+}
+
+export function buildHeyGenEngineConfig(
+  engine: HeyGenAvatarEngine,
+): HeyGenEngineConfig {
+  return { type: engine };
+}
diff --git a/apps/server/api/src/services/integrations/heygen/helpers/heygen-speech.ts b/apps/server/api/src/services/integrations/heygen/helpers/heygen-speech.ts
