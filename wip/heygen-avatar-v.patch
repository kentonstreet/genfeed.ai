+          provider: 'heygen',
+        },
+        3.33,
+        NOW,
+      );
+
+    expect(quote(1000)).toMatchObject({
+      snapshot: { credits: 10, providerCostUsd: 0.03 },
+      status: 'priced',
+    });
+    expect(quote(5000)).toMatchObject({
+      snapshot: { credits: applyMargin(0.15, 3.33), providerCostUsd: 0.15 },
+      status: 'priced',
+    });
+    // Without a character count the request is unpriceable, never flat-billed.
+    expect(
+      quoteModelBillablePricing(
+        profile,
+        { modelKey: 'heygen/heygen-voice-1', provider: 'heygen' },
+        3.33,
+        NOW,
+      ),
+    ).toMatchObject({ status: 'unresolved' });
+  });
+
+  it('quotes Avatar IV by avatar type: photo is cheaper than video and studio avatars', async () => {
+    const { profile } = await seededProfile('heygen/avatar-iv');
+    const credits = (avatarType: string) => {
+      const quote = quoteModelBillablePricing(
+        profile,
+        {
+          duration: 5,
+          modelKey: 'heygen/avatar-iv',
+          provider: 'heygen',
+          selectors: { avatar_type: avatarType },
+        },
+        3.33,
+        NOW,
+      );
+      if (quote.status !== 'priced') throw new Error(quote.reason);
+      return quote.snapshot.credits;
+    };
+
+    expect(credits('photo_avatar')).toBe(applyMargin(0.1925, 3.33));
+    expect(credits('digital_twin')).toBe(applyMargin(0.4025, 3.33));
+    expect(credits('studio_avatar')).toBe(applyMargin(0.4025, 3.33));
+    expect(credits('photo_avatar')).toBeLessThan(credits('digital_twin'));
+    // An avatar type the sheet does not price is refused, not guessed.
+    expect(
+      quoteModelBillablePricing(
+        profile,
+        {
+          duration: 5,
+          modelKey: 'heygen/avatar-iv',
+          provider: 'heygen',
+          selectors: { avatar_type: 'prompt' },
+        },
+        3.33,
+        NOW,
+      ),
+    ).toMatchObject({ status: 'unresolved' });
+  });
+
+  it('quotes Avatar V at 200 credits for a 5-second clip', async () => {
+    const { profile } = await seededProfile('heygen/avatar-v');
+
+    expect(
+      quoteModelBillablePricing(
+        profile,
+        { duration: 5, modelKey: 'heygen/avatar-v', provider: 'heygen' },
+        3.33,
+        NOW,
+      ),
+    ).toMatchObject({
+      snapshot: { credits: 200, providerCostUsd: 0.6 },
+      status: 'priced',
+    });
+  });
+});
