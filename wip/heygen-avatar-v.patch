+  it('quotes HeyGen Voice per submitted character at the list price and 3.33x margin', async () => {
+    const { profile } = await seededProfile('heygen/heygen-voice-1');
+    const quote = (characters: number) =>
+      quoteModelBillablePricing(
+        profile,
